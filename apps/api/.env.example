PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000

# Storage (SQLite file + masked evidence photos)
DATA_DIR=./data

# Hosted open-model AI (optional). Leave the key empty to run fully local/rule-based.
# Free key from https://build.nvidia.com (NVIDIA API catalog). Any OpenAI-compatible endpoint works.
NVIDIA_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# One model per kind of task. Run `pnpm --filter @repo/api ai:check` to test them with your key.
# fast = chat, voice, short text · translate = translation · vision = reading slip photos
# LLM_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_MODEL_TRANSLATE=google/gemma-4-31b-it
# LLM_MODEL_VISION=meta/llama-3.2-90b-vision-instruct

# Local OCR (tesseract binary + traineddata). Run scripts/setup-assets.sh to download models.
TESSERACT_BIN=tesseract
TESSDATA_DIR=./tessdata
OCR_LANGS=eng+hin

# PDF fonts (downloaded by scripts/setup-assets.sh)
FONT_DIR=./assets/fonts

# Admin token for editing the grievance channel directory (PUT/DELETE /grievance-channels)
ADMIN_TOKEN=change-me

# Date (YYYY-MM-DD) on which someone verified the NFSA defaults against nfsa.gov.in; empty = not verified
RULE_DEFAULTS_LAST_VERIFIED=

# Photo quality gate thresholds
QUALITY_MIN_SHARPNESS=40
QUALITY_MIN_BRIGHTNESS=50
QUALITY_MAX_BRIGHTNESS=240
QUALITY_MIN_CONTRAST=18
QUALITY_MIN_SHORT_SIDE=600
